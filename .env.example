# Copy this file to .env.local, then fill in the values there. Next.js does not load .env.example.
# Site operator: public browser connection values only (see docs/study-setup.md).
# Never use a service_role, secret key, or database password here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
